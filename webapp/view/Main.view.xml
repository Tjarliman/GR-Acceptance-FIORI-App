<mvc:View
    controllerName="zmm.gracceptance.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page id="mainPage" title="{i18n>appTitle}" class="sapUiContentPadding">
        <content>

            <!-- Warehouse Number -->
            <Panel class="sapUiSmallMarginBottom">
                <content>
                    <form:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12"
                        emptySpanXL="4" emptySpanL="4" emptySpanM="4" emptySpanS="0"
                        columnsXL="1" columnsL="1" columnsM="1">
                        <form:content>
                            <Label text="{i18n>warehouseNumber}" required="true" />
                            <Input
                                id="inputWarehouse"
                                value="{local>/warehouseNumber}"
                                placeholder="{i18n>warehousePlaceholder}"
                                maxLength="4"
                                width="8rem" />
                        </form:content>
                    </form:SimpleForm>
                </content>
            </Panel>

            <!-- Scan Inputs -->
            <Panel headerText="{i18n>scanInputs}" class="sapUiSmallMarginBottom">
                <content>
                    <form:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12"
                        emptySpanXL="4" emptySpanL="4" emptySpanM="4" emptySpanS="0"
                        columnsXL="1" columnsL="1" columnsM="1">
                        <form:content>
                            <Label text="{i18n>serialNumberEngine}" />
                            <Input
                                id="inputEngine"
                                value="{local>/scanEngine}"
                                placeholder="{i18n>scanEnginePlaceholder}"
                                submit="onEngineScan"
                                change="onEngineScan" />
                            <Label text="{i18n>uiiFrame}" />
                            <Input
                                id="inputFrame"
                                value="{local>/scanFrame}"
                                enabled="{= ${local>/lastEngine} !== '' }"
                                placeholder="{i18n>scanFramePlaceholder}"
                                submit="onFrameScan"
                                change="onFrameScan" />
                        </form:content>
                    </form:SimpleForm>
                </content>
            </Panel>

            <!-- Scanned Items Table -->
            <Table
                id="scannedItemsTable"
                items="{local>/scannedItems}"
                mode="SingleSelectLeft"
                growing="true"
                growingThreshold="50"
                alternateRowColors="true"
                sticky="ColumnHeaders"
                noDataText="No items scanned yet.">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>scannedItems}" level="H3" />
                        <ToolbarSpacer />
                        <Button
                            text="{i18n>clear}"
                            icon="sap-icon://eraser"
                            press="onDeleteItem" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column width="4em"><Text text="{i18n>colNo}" /></Column>
                    <Column><Text text="{i18n>colMaterial}" /></Column>
                    <Column><Text text="{i18n>colDescription}" /></Column>
                    <Column><Text text="{i18n>colSerialNumber}" /></Column>
                    <Column><Text text="{i18n>colUii}" /></Column>
                    <Column width="6em" hAlign="Center"><Text text="{i18n>colStatus}" /></Column>
                </columns>
                <items>
                    <ColumnListItem type="Inactive">
                        <cells>
                            <Text text="{local>No}" />
                            <Text text="{local>Material}" />
                            <Text text="{local>MaterialDesc}" />
                            <Text text="{local>SerialNumber}" />
                            <Text text="{local>FrameNumber}" />
                            <core:Icon
                                src="sap-icon://accept"
                                color="Positive"
                                size="1.2rem" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

        </content>

        <!-- Footer: Post -->
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    text="{i18n>post}"
                    icon="sap-icon://shipping-status"
                    type="Emphasized"
                    press="onPost" />
            </OverflowToolbar>
        </footer>
    </Page>

</mvc:View>
